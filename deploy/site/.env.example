# /opt/site/.env (droits 600)
# Scaleway Transactional Email (fr-par) : utilisateur = ID du projet, mot de passe = clé secrète
# d'une application IAM limitée à TransactionalEmail. Domaine mathis-rvrs.fr vérifié chez Scaleway.
SMTP_HOST=smtp.tem.scaleway.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=contact@mathis-rvrs.fr

# Calendrier /dispo : ligne écrite par « bash /opt/db/create-app-db.sh dispo /opt/site/.env »
# DATABASE_URL=mysql://dispo:<mot de passe>@mysql:3306/dispo

# Terrains libres d'Impact Stadium dans /dispo (dispo-courts.php) : compte Gestion Sports dédié,
# créé sur https://imp4ctstadium-admin.gestion-sports.com. Vide = Impact affiché « pas connecté ».
GS_IMPACT_EMAIL=
GS_IMPACT_PASSWORD=

# Dashboard /poker (stats Winamax du club) : clé d'accès, 16 caractères min (openssl rand -hex 24)
POKER_CLUB_KEY=
