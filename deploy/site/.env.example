# /opt/site/.env (droits 600)
# Scaleway Transactional Email (fr-par) : utilisateur = ID du projet, mot de passe = clé secrète
# d'une application IAM limitée à TransactionalEmail. Domaine mathis-rvrs.fr vérifié chez Scaleway.
SMTP_HOST=smtp.tem.scaleway.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=contact@mathis-rvrs.fr
