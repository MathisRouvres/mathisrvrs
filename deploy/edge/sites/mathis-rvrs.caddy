# mathis-rvrs.fr (pile /opt/site).
mathis-rvrs.fr {
	reverse_proxy site-web:80
}

# TRANSITION : www pointe encore vers OVH ; Let's Encrypt ne peut pas valider ce nom.
# Après la bascule DNS de www : retirer « tls internal », puis recharger sans coupure :
#   docker compose -f /opt/edge/docker-compose.yml exec caddy caddy reload --config /etc/caddy/Caddyfile
www.mathis-rvrs.fr {
	tls internal
	redir https://mathis-rvrs.fr{uri} permanent
}
