# Espace privé : page de connexion et sites protégés par elle (snippet « private » du Caddyfile).
auth.mathis-rvrs.fr {
	reverse_proxy auth-web:8080
}

pma.mathis-rvrs.fr {
	import private
	reverse_proxy pma-web:80
}

travaux.mathis-rvrs.fr {
	import private
	reverse_proxy travaux-web:8090
}

arbitre.mathis-rvrs.fr {
	import private
	reverse_proxy arbitre-web:3210
}

job.mathis-rvrs.fr {
	import private
	reverse_proxy job-web:5190
}

# App budget du couple (compte « couple » limité à cet hôte).
budget.mathis-rvrs.fr {
	import private
	reverse_proxy budget-web:5200
}
