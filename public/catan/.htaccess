# Configuration Apache du dossier publie.
#
# `_headers` ne sert qu'a Netlify et Cloudflare Pages ; un hebergement Apache classique
# ignore ce fichier. Celui-ci porte les memes decisions, dans la langue d'Apache, et permet
# de deposer le jeu tel quel dans un sous-dossier d'un site existant — par exemple
# https://exemple.fr/jeux/hexland/. Tous les chemins du build sont relatifs : aucun
# reglage supplementaire n'est necessaire pour changer de sous-dossier.
#
# Chaque bloc est garde par un <IfModule> : sur un hebergement ou le module manque, le
# fichier reste valide et le jeu fonctionne, simplement sans l'optimisation concernee.

Options -Indexes

# ---------------------------------------------------------------------------
# Types MIME
# ---------------------------------------------------------------------------
# Sans `application/wasm`, le navigateur refuse la compilation en flux et retombe sur un
# chemin plus lent, quand il ne refuse pas le fichier.
AddType application/wasm .wasm
AddType application/octet-stream .pck
AddType text/javascript .js
AddType application/manifest+json .webmanifest

# ---------------------------------------------------------------------------
# Fichiers pre-compresses
# ---------------------------------------------------------------------------
# Le build produit un .br et un .gz a cote de chaque gros fichier. Les servir tels quels
# evite de recompresser 39 Mo de wasm a chaque telechargement : 8 Mo transitent au lieu
# de 38.
# Les deux modules sont necessaires ENSEMBLE : servir le .br sans pouvoir poser
# l'en-tete Content-Encoding livrerait un fichier compresse presente comme du texte, que
# le navigateur ne saurait pas lire. Le double garde evite ce cas.
<IfModule mod_headers.c>
	<IfModule mod_rewrite.c>
		RewriteEngine On

		RewriteCond %{HTTP:Accept-Encoding} br
		RewriteCond %{REQUEST_FILENAME}.br -f
		RewriteRule ^(.*)$ $1.br [L]

		RewriteCond %{HTTP:Accept-Encoding} gzip
		RewriteCond %{REQUEST_FILENAME}.gz -f
		RewriteRule ^(.*)$ $1.gz [L]
	</IfModule>
</IfModule>

# Un fichier reecrit garde le type MIME de son extension de compression : on retablit le
# type reel, sans quoi le navigateur telecharge index.wasm.br au lieu de l'executer.
<FilesMatch "\.wasm\.(br|gz)$">
	ForceType application/wasm
</FilesMatch>
<FilesMatch "\.js\.(br|gz)$">
	ForceType text/javascript
</FilesMatch>
<FilesMatch "\.html\.(br|gz)$">
	ForceType text/html
</FilesMatch>
<FilesMatch "\.json\.(br|gz)$">
	ForceType application/json
</FilesMatch>
<FilesMatch "\.pck\.(br|gz)$">
	ForceType application/octet-stream
</FilesMatch>

<IfModule mod_headers.c>
	<FilesMatch "\.br$">
		Header set Content-Encoding br
		Header append Vary Accept-Encoding
	</FilesMatch>
	<FilesMatch "\.gz$">
		Header set Content-Encoding gzip
		Header append Vary Accept-Encoding
	</FilesMatch>
</IfModule>

# Recompresser un fichier deja compresse le corromprait.
<IfModule mod_deflate.c>
	SetEnvIfNoCase Request_URI \.(br|gz)$ no-gzip dont-vary
</IfModule>

# ---------------------------------------------------------------------------
# Securite et cache
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
	Header set X-Content-Type-Options nosniff
	Header set Referrer-Policy no-referrer
	# Le jeu ne charge aucune ressource distante : aucune origine externe n'est
# autorisee. En revanche le moteur Godot evalue du code au demarrage et fabrique
# des ressources en blob: — une politique sans 'unsafe-eval' ni blob: bloquait le
# chargement a 0 %.
	Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'none'"

	# La page, le service worker et le manifeste changent a chaque mise en ligne : les
	# mettre en cache longtemps empecherait toute mise a jour d'arriver.
	<FilesMatch "^(index\.html|index\.service\.worker\.js|index\.manifest\.json)(\.(br|gz))?$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>

	# Le wasm, le pck et les images portent la version dans le cache du service worker :
	# le navigateur peut les garder indefiniment.
	<FilesMatch "\.(wasm|pck|png)(\.(br|gz))?$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>
